{
  "$schema": "https://unpkg.com/wrangler@4.148.0/config-schema.json",
  "name": "wujun-study",
  "account_id": "ef7863c4de93e71c3496f940c8ab4865",
  "compatibility_date": "2026-11-18",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "base_path": "/wujun-study"
