{
  "name": "wujun-study",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/prepare_chunks.mjs && vite build && node scripts/write_release.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node scripts/verify.mjs",
    "deploy:check": "node scripts/deploy_portfolio.mjs --dry-run",
    "deploy": "npm run build && node scripts/deploy_portfolio.mjs"
  },
  "devDependencies": {
    "vite": "6.4.6",
    "wrangler": "4.163.0"
  }
}
